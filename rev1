<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perlette ou Perlereau ✨</title>
    <!-- Tailwind CSS pour les styles modernes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti Library pour l'animation d'explosion -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        babyBoy: '#4A90E2',
                        babyGirl: '#FF85A2',
                        gold: '#D4AF37',
                    },
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            background-attachment: fixed;
            min-height: 100vh;
        }

        .float-card {
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08);
            backdrop-filter: blur(8px);
            background: rgba(255, 255, 255, 0.92);
        }

        #scratchCanvas {
            touch-action: none;
            cursor: pointer;
        }

        #confettiCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 100;
        }
    </style>
</head>
<body class="text-slate-800 font-sans antialiased overflow-x-hidden selection:bg-pink-200">

    <canvas id="confettiCanvas"></canvas>

    <!-- Mode Test Quick Bar (Résultat configuré sur Perlette par défaut) -->
    <header class="bg-white/80 backdrop-blur border-b border-slate-200 sticky top-0 z-40 px-4 py-2.5 text-xs md:text-sm shadow-sm flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center space-x-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-medium text-slate-600">Perlette ou Perlereau</span>
        </div>
        <div class="flex items-center space-x-3">
            <button onclick="toggleAudio()" id="audioBtn" title="Activer/Désactiver le son" class="bg-slate-100 hover:bg-slate-200 p-1.5 px-3 rounded-lg text-slate-600 transition flex items-center space-x-1.5">
                <i class="fa-solid fa-volume-high"></i>
                <span class="text-xs font-semibold">Son</span>
            </button>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8 space-y-10">

        <!-- Hero Title -->
        <section class="text-center space-y-4">
            <div class="inline-flex items-center space-x-2 bg-gradient-to-r from-pink-100 via-amber-100 to-blue-100 border border-amber-200/60 rounded-full px-4 py-1.5 text-xs font-semibold tracking-wider uppercase text-amber-900 shadow-sm">
                <span>✨ Un petit secret se prépare ✨</span>
            </div>
            <h1 class="font-serif text-4xl md:text-6xl font-extrabold tracking-tight bg-gradient-to-r from-pink-500 via-amber-600 to-blue-600 bg-clip-text text-transparent">
                Perlette ou Perlereau
            </h1>
        </section>

        <!-- SECTION 1: COMPTE À REBOURS (Sans millisecondes) -->
        <section id="countdownSection" class="float-card rounded-3xl p-6 md:p-8 border border-white text-center space-y-6 transition-all duration-500">
            <div class="space-y-2">
                <h2 class="font-serif text-3xl font-bold text-slate-800">
                    <i class="fa-regular fa-clock text-amber-500 mr-2"></i>Le Grand Décompte
                </h2>
            </div>

            <!-- Timer Grid (Heures, Minutes, Secondes uniquement) -->
            <div class="grid grid-cols-3 gap-3 md:gap-6 max-w-sm mx-auto">
                <div class="bg-gradient-to-b from-pink-50 to-pink-100/50 border border-pink-200 rounded-2xl p-4 text-center">
                    <span id="hours" class="block font-serif text-3xl md:text-5xl font-extrabold text-pink-600">05</span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-pink-400">Heures</span>
                </div>
                <div class="bg-gradient-to-b from-purple-50 to-purple-100/50 border border-purple-200 rounded-2xl p-4 text-center">
                    <span id="minutes" class="block font-serif text-3xl md:text-5xl font-extrabold text-purple-600">00</span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-purple-400">Minutes</span>
                </div>
                <div class="bg-gradient-to-b from-amber-50 to-amber-100/50 border border-amber-200 rounded-2xl p-4 text-center">
                    <span id="seconds" class="block font-serif text-3xl md:text-5xl font-extrabold text-amber-600">00</span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Secondes</span>
                </div>
            </div>

            <!-- Bouton passer le chrono protégé par mot de passe -->
            <div class="pt-2 flex justify-center">
                <button onclick="promptPasscodeForSkip()" class="inline-flex items-center space-x-2 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-900 font-semibold px-6 py-3 rounded-full shadow-lg shadow-amber-200 hover:shadow-xl transition transform hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fa-solid fa-key text-slate-800"></i>
                    <span>Passer le chrono</span>
                </button>
            </div>
        </section>

        <!-- SECTION 2: CARTE À GRATTER DORÉE -->
        <section id="scratchSection" class="hidden float-card rounded-3xl p-6 md:p-10 border border-white text-center space-y-6 transition-all duration-700">
            <div class="space-y-2">
                <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Carte Magique</span>
                <h2 class="font-serif text-3xl font-bold text-slate-800">Grattez pour Révéler le Secret !</h2>
            </div>

            <!-- Container Carte à gratter -->
            <div class="relative w-full max-w-md mx-auto aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border-4 border-amber-300/60 select-none">
                
                <!-- Résultat Caché -->
                <div id="secretResult" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center transition-all duration-500 bg-pink-100 text-pink-900">
                    <div class="w-20 h-20 rounded-full bg-white/80 backdrop-blur flex items-center justify-center text-4xl shadow-md mb-4 animate-bounce">
                        👧
                    </div>
                    <h3 class="font-serif text-3xl md:text-4xl font-black tracking-tight">C'est une Perlette ! 👧💖👶✨</h3>
                </div>

                <!-- Surface Canvas Dorée à Gratter -->
                <canvas id="scratchCanvas" class="absolute inset-0 z-10 w-full h-full"></canvas>
            </div>

            <div id="revealNotice" class="hidden animate-fade-in text-emerald-600 font-semibold text-sm">
                🎉 Secret révélé ! Vous pouvez continuer de gratter la carte si vous le souhaitez.
            </div>
        </section>

        <!-- SECTION 3: FORMULAIRE DERNIER GUESS & MESSAGES -->
        <section id="guestbookSection" class="float-card rounded-3xl p-6 md:p-8 border border-white space-y-6">
            <div class="text-center space-y-2">
                <h2 class="font-serif text-3xl font-bold text-slate-800">
                    <i class="fa-solid fa-envelope-open-text text-pink-500 mr-2"></i>Votre Dernier Guess & Message Secret
                </h2>
            </div>

            <!-- Formulaire de Soumission Privée -->
            <form id="guessForm" onsubmit="handleFormSubmit(event)" class="space-y-4 max-w-lg mx-auto">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Votre Prénom / Famille *</label>
                    <input type="text" id="guestName" required placeholder="ex: Tata Sophie & Parrain" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-400 focus:border-amber-400 outline-none transition bg-white/80">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Votre Pronostic *</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="prediction" value="Perlette" required class="peer hidden">
                            <div class="p-3 text-center rounded-xl border-2 border-slate-200 peer-checked:border-pink-500 peer-checked:bg-pink-50 transition font-semibold text-slate-700 peer-checked:text-pink-600 flex items-center justify-center space-x-2">
                                <span>🩷 Perlette</span>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="prediction" value="Perlereau" required class="peer hidden">
                            <div class="p-3 text-center rounded-xl border-2 border-slate-200 peer-checked:border-blue-500 peer-checked:bg-blue-50 transition font-semibold text-slate-700 peer-checked:text-blue-600 flex items-center justify-center space-x-2">
                                <span>💙 Perlereau</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Votre Message *</label>
                    <textarea id="guestMessage" rows="3" required placeholder="Écrivez ici votre petit mot..." class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-400 focus:border-amber-400 outline-none transition bg-white/80"></textarea>
                </div>

                <button type="submit" class="w-full bg-gradient-to-r from-slate-800 to-slate-900 hover:from-black hover:to-slate-800 text-white font-bold py-3.5 rounded-xl shadow-md transition transform hover:-translate-y-0.5">
                    Envoyer Mon Message ✨
                </button>
            </form>

            <!-- Notification de Confirmation -->
            <div id="confirmationBanner" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-center text-emerald-800 space-y-1 animate-fade-in max-w-lg mx-auto">
                <i class="fa-solid fa-circle-check text-2xl text-emerald-500 mb-1"></i>
                <h4 class="font-bold">Merci pour votre message !</h4>
            </div>

            <!-- Espace Parents Protege par Mot de passe -->
            <div class="pt-6 border-t border-slate-200/80 text-center">
                <button onclick="promptPasscodeForParents()" class="text-xs text-slate-400 hover:text-slate-600 font-medium underline">
                    <i class="fa-solid fa-lock mr-1"></i>Espace Parents
                </button>

                <div id="adminPanel" class="hidden mt-4 p-4 bg-slate-50 border border-slate-200 rounded-2xl max-w-md mx-auto space-y-3 text-left">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-700">Messages reçus (<span id="msgCount">0</span>)</span>
                        <button onclick="downloadCSV()" class="bg-amber-500 hover:bg-amber-600 text-slate-900 text-xs font-bold px-3 py-1.5 rounded-lg transition">
                            <i class="fa-solid fa-download mr-1"></i>Exporter en CSV
                        </button>
                    </div>
                    <div id="adminMsgList" class="max-h-48 overflow-y-auto space-y-2 text-xs">
                        <!-- Entries rendered here for parents -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Modal Mot de Passe -->
    <div id="passwordModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full space-y-4 shadow-2xl border border-slate-100">
            <div class="text-center space-y-1">
                <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto text-xl mb-2">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h3 class="font-bold text-slate-800 text-lg">Accès Sécurisé</h3>
                <p class="text-xs text-slate-500">Veuillez entrer le mot de passe</p>
            </div>
            <div>
                <input type="password" id="passcodeInput" placeholder="Mot de passe" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-400 outline-none text-center font-bold">
                <p id="passwordError" class="hidden text-xs text-red-500 text-center mt-1 font-semibold">Mot de passe incorrect</p>
            </div>
            <div class="flex space-x-2">
                <button onclick="closePasswordModal()" class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2 rounded-xl transition text-sm">Annuler</button>
                <button onclick="validatePassword()" class="w-1/2 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold py-2 rounded-xl transition text-sm">Valider</button>
            </div>
        </div>
    </div>

    <script>
        const PASSCODE = "augustine";
        let pendingAction = null;

        // 1. DECOMPTE DE 5 HEURES PERSISTANT
        const FIVE_HOURS_MS = 5 * 60 * 60 * 1000;
        let countdownEndTime = localStorage.getItem('gender_reveal_target_time');

        if (!countdownEndTime) {
            countdownEndTime = new Date().getTime() + FIVE_HOURS_MS;
            localStorage.setItem('gender_reveal_target_time', countdownEndTime);
        } else {
            countdownEndTime = parseInt(countdownEndTime, 10);
        }

        let isScratchRevealed = false;
        let isAudioMuted = false;
        let audioCtx = null;

        function playJoyfulSound() {
            if (isAudioMuted) return;
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                
                const notes = [261.63, 329.63, 392.00, 523.25, 659.25];
                notes.forEach((freq, index) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, audioCtx.currentTime + index * 0.12);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime + index * 0.12);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + index * 0.12 + 0.4);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(audioCtx.currentTime + index * 0.12);
                    osc.stop(audioCtx.currentTime + index * 0.12 + 0.5);
                });
            } catch (e) {
                console.log("Audio not active");
            }
        }

        function toggleAudio() {
            isAudioMuted = !isAudioMuted;
            const btn = document.getElementById('audioBtn');
            btn.innerHTML = isAudioMuted ? 
                '<i class="fa-solid fa-volume-xmark text-red-500"></i><span class="text-xs font-semibold">Mute</span>' : 
                '<i class="fa-solid fa-volume-high"></i><span class="text-xs font-semibold">Son</span>';
        }

        // Mise à jour du chrono (Heures, Minutes, Secondes)
        function updateCountdown() {
            const now = new Date().getTime();
            const distance = countdownEndTime - now;

            if (distance <= 0) {
                skipCountdown();
                return;
            }

            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('hours').innerText = String(hours).padStart(2, '0');
            document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
            document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
        }

        setInterval(updateCountdown, 1000);

        function openPasswordModal(action) {
            pendingAction = action;
            document.getElementById('passwordModal').classList.remove('hidden');
            document.getElementById('passcodeInput').value = '';
            document.getElementById('passwordError').classList.add('hidden');
            document.getElementById('passcodeInput').focus();
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.add('hidden');
            pendingAction = null;
        }

        function validatePassword() {
            const input = document.getElementById('passcodeInput').value.trim();
            if (input === PASSCODE) {
                const action = pendingAction;
                closePasswordModal();
                if (action === 'skip') {
                    skipCountdown();
                } else if (action === 'parents') {
                    openAdminPanel();
                }
            } else {
                document.getElementById('passwordError').classList.remove('hidden');
            }
        }

        function promptPasscodeForSkip() {
            openPasswordModal('skip');
        }

        function promptPasscodeForParents() {
            openPasswordModal('parents');
        }

        function skipCountdown() {
            document.getElementById('countdownSection').classList.add('hidden');
            document.getElementById('scratchSection').classList.remove('hidden');
            initScratchCanvas();
        }

        let canvas, ctx;
        let isDrawing = false;

        function initScratchCanvas() {
            canvas = document.getElementById('scratchCanvas');
            ctx = canvas.getContext('2d', { willReadFrequently: true });

            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;

            drawGoldSurface();

            canvas.addEventListener('mousedown', startScratching);
            canvas.addEventListener('mousemove', scratch);
            canvas.addEventListener('mouseup', stopScratching);
            canvas.addEventListener('mouseleave', stopScratching);

            canvas.addEventListener('touchstart', startScratching, { passive: true });
            canvas.addEventListener('touchmove', scratch, { passive: true });
            canvas.addEventListener('touchend', stopScratching);
        }

        function drawGoldSurface() {
            const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
            grad.addColorStop(0, '#D4AF37');
            grad.addColorStop(0.25, '#FFF8DC');
            grad.addColorStop(0.5, '#AA771C');
            grad.addColorStop(0.75, '#FCF6BA');
            grad.addColorStop(1, '#B38728');

            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = "rgba(255, 255, 255, 0.25)";
            for (let i = 0; i < 70; i++) {
                const x = Math.random() * canvas.width;
                const y = Math.random() * canvas.height;
                const r = Math.random() * 3 + 1;
                ctx.beginPath();
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.font = "bold 18px Outfit, sans-serif";
            ctx.fillStyle = "rgba(80, 50, 10, 0.75)";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText("✨ Grattez ici pour révéler ✨", canvas.width / 2, canvas.height / 2);
        }

        function getPointerPos(e) {
            const rect = canvas.getBoundingClientRect();
            let clientX = e.clientX;
            let clientY = e.clientY;

            if (e.touches && e.touches.length > 0) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            }

            return {
                x: clientX - rect.left,
                y: clientY - rect.top
            };
        }

        function startScratching(e) {
            isDrawing = true;
            scratch(e);
        }

        function scratch(e) {
            if (!isDrawing) return;

            const pos = getPointerPos(e);
            ctx.globalCompositeOperation = 'destination-out';
            ctx.beginPath();
            ctx.arc(pos.x, pos.y, 28, 0, Math.PI * 2);
            ctx.fill();

            if (!isScratchRevealed) {
                check10PercentThreshold();
            }
        }

        function stopScratching() {
            isDrawing = false;
        }

        function check10PercentThreshold() {
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const pixels = imgData.data;
            let transparentPixels = 0;

            for (let i = 3; i < pixels.length; i += 16) {
                if (pixels[i] === 0) transparentPixels++;
            }

            const totalSampled = pixels.length / 16;
            const percentage = (transparentPixels / totalSampled) * 100;

            if (percentage >= 10) {
                triggerRevealAndConfetti();
            }
        }

        function triggerRevealAndConfetti() {
            if (isScratchRevealed) return;
            isScratchRevealed = true;

            document.getElementById('revealNotice').classList.remove('hidden');

            playJoyfulSound();
            triggerConfetti();
        }

        function triggerConfetti() {
            const colors = ['#FF85A2', '#FFD1DC', '#FFD700', '#FFFFFF'];

            confetti({
                particleCount: 120,
                spread: 80,
                origin: { y: 0.6 },
                colors: colors
            });

            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 },
                    colors: colors
                });
            }, 250);

            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 },
                    colors: colors
                });
            }, 400);
        }

        const MESSAGES_KEY = 'gender_reveal_private_messages';

        function getPrivateMessages() {
            const raw = localStorage.getItem(MESSAGES_KEY);
            return raw ? JSON.parse(raw) : [];
        }

        function savePrivateMessages(list) {
            localStorage.setItem(MESSAGES_KEY, JSON.stringify(list));
        }

        function handleFormSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('guestName').value.trim();
            const message = document.getElementById('guestMessage').value.trim();
            const prediction = document.querySelector('input[name="prediction"]:checked').value;

            if (!name || !message || !prediction) return;

            const newEntry = {
                name: name,
                prediction: prediction,
                message: message,
                date: new Date().toLocaleString('fr-FR')
            };

            const list = getPrivateMessages();
            list.unshift(newEntry);
            savePrivateMessages(list);

            document.getElementById('guessForm').reset();
            document.getElementById('confirmationBanner').classList.remove('hidden');

            setTimeout(() => {
                document.getElementById('confirmationBanner').scrollIntoView({ behavior: 'smooth' });
            }, 100);

            playJoyfulSound();
            updateAdminPanel();
        }

        function openAdminPanel() {
            const panel = document.getElementById('adminPanel');
            panel.classList.remove('hidden');
            updateAdminPanel();
        }

        function updateAdminPanel() {
            const list = getPrivateMessages();
            document.getElementById('msgCount').innerText = list.length;

            const container = document.getElementById('adminMsgList');
            if (list.length === 0) {
                container.innerHTML = '<p class="text-slate-400 italic">Aucun message reçu pour le moment.</p>';
                return;
            }

            container.innerHTML = list.map(item => `
                <div class="p-2.5 bg-white border border-slate-200 rounded-xl space-y-1">
                    <div class="flex justify-between items-center font-bold text-slate-800">
                        <span>${escapeHtml(item.name)} (${item.prediction})</span>
                        <span class="text-[10px] text-slate-400 font-normal">${item.date}</span>
                    </div>
                    <p class="text-slate-600 italic">"${escapeHtml(item.message)}"</p>
                </div>
            `).join('');
        }

        function downloadCSV() {
            const list = getPrivateMessages();
            if (list.length === 0) {
                alert("Aucun message à exporter pour l'instant !");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,Nom/Famille,Pronostic,Message,Date\n";
            list.forEach(row => {
                const name = `"${row.name.replace(/"/g, '""')}"`;
                const pred = `"${row.prediction}"`;
                const msg = `"${row.message.replace(/"/g, '""')}"`;
                const date = `"${row.date}"`;
                csvContent += `${name},${pred},${msg},${date}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `perlette_messages_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        // Support touche Entrée pour le modal mot de passe
        document.getElementById('passcodeInput')?.addEventListener('keyup', (e) => {
            if (e.key === 'Enter') validatePassword();
        });

        window.addEventListener('resize', () => {
            if (canvas && !isScratchRevealed) {
                const rect = canvas.getBoundingClientRect();
                canvas.width = rect.width;
                canvas.height = rect.height;
                drawGoldSurface();
            }
        });
    </script>
</body>
</html>
